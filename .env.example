# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

ENVIRONMENT=development
DEBUG=true

CONTACT_RECEIVER_EMAIL=surya.re1208@gmail.com
CONTACT_RATE_LIMIT_PER_HOUR=5

# SMTP is optional. Leave these blank and the contact form still works in
# full — submissions are stored in storage/contact_submissions.db either
# way. Fill these in when you want an email notification too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
