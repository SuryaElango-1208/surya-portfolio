# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

ENVIRONMENT=development
DEBUG=true

CONTACT_RECEIVER_EMAIL=surya.re1208@gmail.com
CONTACT_RATE_LIMIT_PER_HOUR=5

# Email notification is optional. Leave this blank and the contact form
# still works in full — submissions are stored in
# storage/contact_submissions.db either way. Fill this in when you want
# an email notification too.
#
# Sign up free at https://resend.com, verify the email you sign up with,
# and create an API key from the dashboard. Without verifying a custom
# domain, Resend's sandbox sender (onboarding@resend.dev) can only send
# TO the email address you signed up with — which is exactly this form's
# use case, since it only ever notifies the site owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio Contact Form <onboarding@resend.dev>
